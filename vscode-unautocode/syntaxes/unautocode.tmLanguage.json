{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "UnAutoCode",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#registers"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.semicolon.uac",
                    "match": ";.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.uac",
                    "match": "\\b(CONTROL|IF)\\b"
                }
            ]
        },
        "registers": {
            "patterns": [
                {
                    "name": "variable.language.register.uac",
                    "match": "\\b[cC]([0-9]|1[0-9]|2[0-5])\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.uac",
                    "match": "\\b-?[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.uac",
                    "match": "\\b-?[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.uac",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.uac",
                    "match": "(\\+|-|\\*|/)"
                },
                {
                    "name": "keyword.operator.relational.uac",
                    "match": "(==|>=|<=|>|<)"
                }
            ]
        }
    },
    "scopeName": "source.uac"
}
